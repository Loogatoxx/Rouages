; Fichier de configuration du projet Godot (format INI de Godot).
; Seul Claude le modifie (voir AGENTS.md).

config_version=5

[application]

config/name="Rouages"
config/description="Tower defense - plateau-puzzle d'horlogerie douce."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Events="*res://game/core/events.gd"
Run="*res://game/core/run.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[input]

poser_tuile={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1)
]
}
tourner_tuile={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82), Object(InputEventMouseButton,"device":-1,"button_index":2)
]
}
annuler={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)
]
}
basculer_camera={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306)
]
}
camera_gauche={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)
]
}
camera_droite={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)
]
}
camera_haut={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)
]
}
camera_bas={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)
]
}
camera_zoom_avant={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":4)
]
}
camera_zoom_arriere={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":5)
]
}
accelerer={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32)
]
}

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
