; Fichier de configuration du projet Godot (format INI de Godot).
; Seul Claude le modifie (voir AGENTS.md).

config_version=5

[application]

config/name="Rouages"
config/description="Tower defense - plateau-puzzle d'horlogerie douce."
run/main_scene="res://game/ui/menu_titre.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icone.png"
config/windows_native_icon="res://assets/icone.ico"

[autoload]

Events="*res://game/core/events.gd"
Run="*res://game/core/run.gd"
Sons="*res://game/core/sons.gd"
Fenetre="*res://game/core/fenetre.gd"
Graphismes="*res://game/core/graphismes.gd"
Touches="*res://game/core/touches.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[input]

poser_tuile={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1)
]
}
tourner_tuile={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82), Object(InputEventMouseButton,"device":-1,"button_index":2)
]
}
annuler={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)
]
}
basculer_camera={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306)
]
}
camera_gauche={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)
]
}
camera_droite={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)
]
}
camera_haut={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)
]
}
camera_bas={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)
]
}
camera_zoom_avant={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":4), Object(InputEventKey,"device":-1,"physical_keycode":61), Object(InputEventKey,"device":-1,"physical_keycode":4194437)
]
}
camera_zoom_arriere={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":5), Object(InputEventKey,"device":-1,"physical_keycode":45), Object(InputEventKey,"device":-1,"physical_keycode":4194435)
]
}
camera_redresser={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81)
]
}
camera_coucher={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":80)
]
}
boutique={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":66)
]
}
plein_ecran={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194342), Object(InputEventKey,"device":-1,"alt_pressed":true,"physical_keycode":4194309)
]
}
accelerer={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32)
]
}
coup_carillon={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":67)
]
}

[internationalization]

locale/translations=PackedStringArray("res://traductions/textes.fr.translation", "res://traductions/textes.en.translation", "res://traductions/textes.pt.translation")

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
