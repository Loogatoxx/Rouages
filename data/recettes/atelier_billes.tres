[gd_resource type="Resource" script_class="RecetteDef" format=3]

[ext_resource type="Script" path="res://game/core/recette_def.gd" id="recette"]
[ext_resource type="Script" path="res://game/core/lot.gd" id="lot"]
[ext_resource type="Resource" path="res://data/tuiles/atelier_soldats.tres" id="source"]
[ext_resource type="Resource" path="res://data/tuiles/atelier_billes.tres" id="produit"]

[sub_resource type="Resource" id="entree"]
