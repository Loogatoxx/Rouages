[resource]
script = ExtResource("depart")
nom = "Le Manège"
description = "La route du nord passe sur une plaque tournante : toutes les deux vagues, le manège tourne et la route part de l’autre côté. Une seconde route, fixe, arrive du sud."
terrain = Rect2i(-5, -5, 11, 11)
chemins = Array[Vector2i]([Vector2i(0, -1), Vector2i(0, -2), Vector2i(0, -3), Vector2i(0, 1), Vector2i(0, 2), Vector2i(0, 3), Vector2i(0, 4), Vector2i(0, 5)])
