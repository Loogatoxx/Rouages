[resource]
script = ExtResource("depart")
nom = "Le Quai"
description = "Deux jetées, l’une au nord, l’autre à l’est. La marée n’en laisse qu’une à sec à chaque vague : déplace tes fanions d’une jetée à l’autre, ou jette un Pont pour t’installer entre les deux."
