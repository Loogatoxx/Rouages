[resource]
script = ExtResource("depart")
nom = "Le Rail"
description = "Un petit train traverse la maquette à intervalle régulier et coupe la route du sud. Il bouscule tout ce qu’il trouve sur la voie, scarabées comme jouets : ne plante pas ton fanion sur le passage à niveau."
terrain = Rect2i(-5, -5, 11, 11)
chemins = Array[Vector2i]([Vector2i(1, 0), Vector2i(2, 0), Vector2i(3, 0), Vector2i(4, 0), Vector2i(5, 0), Vector2i(0, 1), Vector2i(0, 2), Vector2i(0, 3), Vector2i(0, 4), Vector2i(0, 5)])
horloge = Vector2i(0, 0)
reserve = Array[ExtResource("lot")]([SubResource("lot_atelier"), SubResource("lot_droit"), SubResource("lot_coude"), SubResource("lot_croix")])
