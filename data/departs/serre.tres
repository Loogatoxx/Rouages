script = ExtResource("depart")
nom = "La Serre"
description = "L’Horloge est sur un îlot, ceinturé par la rigole d’arrosage. L’allée fait un grand tour avant d’y entrer : pour défendre plus loin, il faut jeter des Ponts par-dessus l’eau."
