[gd_resource type="Resource" script_class="ExtensionDef" format=3]

[ext_resource type="Script" path="res://game/board/extension_def.gd" id="extension"]
[ext_resource type="Script" path="res://game/core/lot.gd" id="lot"]
[ext_resource type="Resource" path="res://data/tuiles/tourelle_canon.tres" id="piece_a"]
[ext_resource type="Resource" path="res://data/tuiles/engrenage_t.tres" id="piece_b"]

[sub_resource type="Resource" id="bonus_a"]
script = ExtResource("lot")
objet = ExtResource("piece_a")
quantite = 1

[sub_resource type="Resource" id="bonus_b"]
script = ExtResource("lot")
objet = ExtResource("piece_b")
quantite = 1

[resource]
script = ExtResource("extension")
id = &"extension_virage"
nom = "Virage"
description = "Planche en L. À la pose : +1 entrée de scarabées, 1 canon à billes, 1 engrenage en T et 15 ressorts. Puis +3 ressorts à chaque fin de vague."
ressorts = 15
revenu = 3
taille = 3
chemins = Array[Vector2i]([Vector2i(1, 0), Vector2i(1, 1), Vector2i(2, 1)])
bonus = Array[ExtResource("lot")]([SubResource("bonus_a"), SubResource("bonus_b")])
