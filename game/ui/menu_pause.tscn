text = "Reprendre"

[node name="Recommencer" type="Button" parent="Voile/Centre/Panneau/Colonne"]
unique_name_in_owner = true
text = "Recommencer la run"

[node name="Options" type="Button" parent="Voile/Centre/Panneau/Colonne"]
unique_name_in_owner = true
text = "Options"

[node name="Aide" type="Button" parent="Voile/Centre/Panneau/Colonne"]
unique_name_in_owner = true
toggle_mode = true
