[gd_scene format=3]

[ext_resource type="Script" path="res://game/ui/menu_pause.gd" id="script"]
[ext_resource type="PackedScene" path="res://game/ui/options.tscn" id="options"]
[ext_resource type="Theme" path="res://game/ui/theme_rouages.tres" id="theme"]

[node name="MenuPause" type="CanvasLayer"]
process_mode = 3
layer = 20
visible = false
script = ExtResource("script")

[node name="Voile" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("theme")
color = Color(0.19, 0.12, 0.08, 0.46)

[node name="Centre" type="CenterContainer" parent="Voile"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panneau" type="PanelContainer" parent="Voile/Centre"]
unique_name_in_owner = true
custom_minimum_size = Vector2(375, 0)

[node name="Colonne" type="VBoxContainer" parent="Voile/Centre/Panneau"]

[node name="Titre" type="Label" parent="Voile/Centre/Panneau/Colonne"]
